{
  "$schema": "https://raw.githubusercontent.com/osmandkitay/aura/v2.0.0-alpha.2/packages/aura-protocol/schema/aura-plan.schema.json",
  "profile": "2.0.0-alpha.2",
  "descriptor": "https://recipes.example/raw/subdirectory/.well-known/aura.json",
  "steps": [
    {
      "stepId": "login",
      "actionId": "login",
      "inputs": [
        {
          "target": "/body",
          "value": {
            "password": "caller-secret"
          }
        }
      ]
    },
    {
      "stepId": "draftA",
      "actionId": "create",
      "inputs": [
        {
          "target": "/body",
          "value": {
            "title": "A"
          }
        },
        {
          "target": "/header/Authorization",
          "from": {
            "step": "login",
            "output": "token"
          }
        }
      ]
    },
    {
      "stepId": "publishA",
      "actionId": "publish",
      "inputs": [
        {
          "target": "/path/id",
          "from": {
            "step": "draftA",
            "output": "created_id"
          }
        },
        {
          "target": "/header/Authorization",
          "from": {
            "step": "login",
            "output": "token"
          }
        }
      ]
    }
  ]
}
