{
  "openapi": "3.1.1",
  "info": {
    "title": "Posts",
    "version": "1"
  },
  "servers": [
    {
      "url": "https://api.example/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Draft": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "Created": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "padding": {
            "type": "string"
          }
        }
      }
    },
    "parameters": {
      "ID": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "requestBodies": {
      "Draft": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Draft"
            }
          }
        }
      }
    },
    "responses": {
      "Created": {
        "description": "created",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Created"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/login": {
      "post": {
        "operationId": "login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "password"
                ],
                "properties": {
                  "password": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "token"
                  ],
                  "properties": {
                    "token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/posts": {
      "post": {
        "operationId": "create",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/Draft"
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/Created"
          },
          "401": {
            "description": "unauthorized"
          }
        }
      },
      "get": {
        "operationId": "listUserOrders",
        "summary": "user",
        "responses": {
          "200": {
            "description": "list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Created"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/posts/{id}/publish": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ID"
        }
      ],
      "post": {
        "operationId": "publish",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "done"
          },
          "403": {
            "description": "forbidden"
          },
          "429": {
            "description": "limited"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "user login list",
        "responses": {
          "204": {
            "description": "done"
          }
        }
      }
    }
  }
}
