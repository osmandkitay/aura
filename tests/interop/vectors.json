  {
    "name": "explicit-api-key-header",
    "action": {
      "id": "api-key",
      "key": "example.call",
      "risk": "medium",
      "origin": {
        "source": "aura-v2",
        "ref": "/actions/wire"
      },
      "entrypoint": {
        "method": "GET",
        "url": "https://api.example/v1/items",
        "encoding": "none"
      },
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "header"
        ],
        "properties": {
          "header": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "X-API-Key"
            ],
            "properties": {
              "X-API-Key": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "bindings": [
        {
          "input": "/header/X-API-Key",
          "in": "header",
          "name": "X-API-Key",
          "style": "simple",
          "explode": false
        }
      ],
      "auth": {
        "kind": "api-key",
        "input": "/header/X-API-Key",
        "name": "X-API-Key"
      },
      "success": [
        {
          "status": 204,
          "contentType": null
        }
      ],
      "outputs": []
    },
    "input": {
      "header": {
        "X-API-Key": "caller-key"
      }
    },
    "expectedRequest": {
      "method": "GET",
      "url": "https://api.example/v1/items",
      "headers": {
        "x-api-key": "caller-key"
      }
