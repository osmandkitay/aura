{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/osmandkitay/aura/v2.0.0-alpha.2/packages/aura-protocol/schema/aura-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "publisher",
    "source",
    "target",
    "actions"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/osmandkitay/aura/v2.0.0-alpha.2/packages/aura-protocol/schema/aura-config.schema.json"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://"
        },
        "role": {
          "enum": [
            "site-owner",
            "third-party"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "version"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://"
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "key",
          "risk",
          "method",
          "path",
          "outputs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$))[A-Za-z0-9](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9_-])?$"
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:\\.[a-z0-9]+)+$"
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "source",
                "pointer",
                "type",
                "required",
                "visibility"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$))[A-Za-z0-9](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9_-])?$"
                },
                "source": {
                  "const": "body"
                },
                "pointer": {
                  "type": "string",
                  "pattern": "^(?:/(?:[^~]|~[01])*)*$"
                },
                "type": {
                  "oneOf": [
                    {
                      "enum": [
                        "object",
                        "array",
                        "string",
                        "number",
                        "integer",
                        "boolean",
                        "null"
                      ]
                    },
                    {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "uniqueItems": true,
                      "contains": {
                        "const": "null"
                      },
                      "items": {
                        "enum": [
                          "object",
                          "array",
                          "string",
                          "number",
                          "integer",
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "visibility": {
                  "enum": [
                    "model",
                    "credential"
                  ]
                }
              }
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$))[A-Za-z0-9](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9_-])?$"
            },
            "uniqueItems": true
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "type": "integer",
                  "minimum": 300,
                  "maximum": 599
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[ -~]+$"
                },
                "resolve": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$))[A-Za-z0-9](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9_-])?$"
                }
              }
            }
          },
          "method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/"
          }
        }
      },
      "minItems": 1
    }
  }
}
