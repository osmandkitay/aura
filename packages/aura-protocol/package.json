{
  "name": "aura-protocol",
  "version": "2.0.0-alpha.1",
  "description": "A lightweight core compiler for deriving, validating, and publishing AURA action surfaces from local source files",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/prepare-dist.mjs",
    "prepublishOnly": "npm run build"
  },
  "bin": {
    "aura-protocol": "./dist/cli/aura-protocol.js",
    "aura-validate": "./dist/cli/aura-validate.js"
  },
  "keywords": [
    "aura",
    "protocol",
    "web",
    "actions",
    "schema",
    "cli"
  ],
  "author": "Dervis-ofAI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/osmandkitay/aura.git",
    "directory": "packages/aura-protocol"
  },
  "homepage": "https://github.com/osmandkitay/aura#readme",
  "bugs": {
    "url": "https://github.com/osmandkitay/aura/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  }
}
