{
  "name": "aura-protocol",
  "version": "2.0.0-alpha.2",
  "description": "Small deterministic AURA compiler, static publisher and linear HTTP runner",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/generate-schema.mjs --check && node scripts/clean-dist.mjs && tsc && node scripts/prepare-dist.mjs",
    "prepublishOnly": "npm run build"
  },
  "bin": {
    "aura-protocol": "./dist/cli/aura-protocol.js",
    "aura-validate": "./dist/cli/aura-validate.js",
    "aura-runner": "./dist/cli/aura-runner.js"
  },
  "keywords": [
    "aura",
    "protocol",
    "web",
    "actions",
    "schema",
    "cli"
  ],
  "author": "Dervis-ofAI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/osmandkitay/aura.git",
    "directory": "packages/aura-protocol"
  },
  "homepage": "https://github.com/osmandkitay/aura#readme",
  "bugs": {
    "url": "https://github.com/osmandkitay/aura/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runner": {
      "types": "./dist/runner/index.d.ts",
      "default": "./dist/runner/index.js"
    },
    "./schemas/*": "./dist/*"
  }
}
